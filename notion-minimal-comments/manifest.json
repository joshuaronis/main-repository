{
  "manifest_version": 3,
  "name": "Notion Minimal Comments",
  "version": "1.1.0",
  "description": "Sets Inline comments to Minimal on standalone Notion pages automatically.",
  "host_permissions": ["https://app.notion.com/*", "https://www.notion.so/*"],
  "content_scripts": [
    {
      "matches": ["https://app.notion.com/*", "https://www.notion.so/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
